# Composer dependencies
/vendor/

# Runtime upload state
/drive/upload/storage/state/*.json
/drive/tokens.json

# Environment and local secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr

# Local/private runtime configuration
/drive/config/*.env
!/drive/config/*.env.example
/drive/config/*secret*
/drive/config/*credentials*
/drive/config/*private*

# Local backups and dumps that may contain secrets
*.bak
*.backup
*.dump
*.sql.gz
