# ArcadeCloud Drive - SMTP
# Copia estas claves al mecanismo de variables de entorno de producción.
# NO guardes credenciales reales dentro del repositorio.

ARCADECLOUD_SMTP_HOST=smtp.titan.email
ARCADECLOUD_SMTP_PORT=587
ARCADECLOUD_SMTP_SECURE=tls
ARCADECLOUD_SMTP_USERNAME=soporte@tu-dominio.example
ARCADECLOUD_SMTP_PASSWORD=CAMBIA_ESTA_CLAVE_EN_PRODUCCION
ARCADECLOUD_SMTP_FROM_EMAIL=soporte@tu-dominio.example
ARCADECLOUD_SMTP_FROM_NAME=Esforzados Hub
ARCADECLOUD_SMTP_REPLY_TO=no-reply@tu-dominio.example
ARCADECLOUD_SMTP_TIMEOUT=20
ARCADECLOUD_SMTP_DEBUG=false
