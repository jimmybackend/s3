{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoverTwoEc2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UseShellDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "RunOnlyApprovedNodes",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-1:084375544416:instance/i-097146ee51c7f7026",
        "arn:aws:ec2:us-east-1:084375544416:instance/i-01b1f1077d7471070"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    },
    {
      "Sid": "StartOnlyFastDrive",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:us-east-1:084375544416:instance/i-01b1f1077d7471070"
    }
  ]
}
